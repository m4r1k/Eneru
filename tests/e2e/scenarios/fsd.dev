# Scenario: Forced Shutdown - UPS signals immediate shutdown required
# Charge/runtime stay above the E2E thresholds (20% / 600s) so only the
# FSD flag can trigger the shutdown (Test 5 asserts the exact FSD reason).
ups.status: OB FSD
ups.load: 45

battery.charge: 80
battery.runtime: 1800
battery.voltage: 42.0

input.voltage: 0.0
input.voltage.nominal: 230
input.frequency: 0.0
input.transfer.low: 170
input.transfer.high: 280

output.voltage: 225.0

device.mfr: Eneru
device.model: E2E Test UPS
