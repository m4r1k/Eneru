#!/bin/sh
# Fake RouterOS CLI used as a LOGIN SHELL (issue #128). sshd runs
# `<login shell> -c "<command>"`; a real RouterOS has no POSIX shell behind
# its CLI, so neither does this: no sh, no PATH, no sudo. It records the
# exact command bytes it received, answers `:put X` with X, accepts any
# `/menu ...` command, and reports anything else the way RouterOS 7.21 does:
# an error line on stdout with exit 0 (RouterOS returns 0 or 1 at random).
[ "$1" = "-c" ] || exit 1
printf '%s\n' "$2" >> /tmp/routeros-received
case "$2" in
  ":put "*) printf '%s\n' "${2#:put }" ;;
  /*) : ;;
  *) printf 'bad command name %s (line 1 column 1)\n' "${2%% *}" ;;
esac
exit 0
